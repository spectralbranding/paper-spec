{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spectralbranding/paper-spec/schema/paper-spec.schema.json",
  "title": "paper-spec",
  "description": "Schema for paper.yaml — a machine-readable specification of a research paper's claims, methodology, and replication requirements. Paper Spec v0.2.0; accepts files declaring any 0.1.x or 0.2.x spec_version.",
  "type": "object",
  "required": ["spec_version", "meta"],
  "additionalProperties": false,

  "properties": {

    "spec_version": {
      "type": "string",
      "description": "Paper Spec version this file conforms to (e.g. '0.2.0').",
      "pattern": "^0\\.[12]\\.\\d+$"
    },

    "meta": {
      "description": "Bibliographic metadata for the paper.",
      "type": "object",
      "required": ["title", "authors"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Full title of the paper."
        },
        "authors": {
          "type": "array",
          "description": "Authors in citation order.",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Author name, 'Last, First' format."
              },
              "orcid": {
                "type": "string",
                "description": "ORCID identifier (e.g. '0000-0002-1234-5678'); empty when the author has none."
              },
              "affiliation": {
                "type": "string",
                "description": "Institutional affiliation."
              }
            }
          },
          "minItems": 1
        },
        "doi": {
          "type": "string",
          "description": "DOI of the published or preprint version (format: 10.NNNN/...).",
          "pattern": "^10\\.\\d{4,}/.+$"
        },
        "date": {
          "type": "string",
          "description": "Publication or submission date (ISO 8601: YYYY-MM-DD or YYYY)."
        },
        "version": {
          "type": "string",
          "description": "Manuscript version (e.g. '1.0', 'v2-revision')."
        },
        "venue": {
          "type": "string",
          "description": "Target or published venue (journal, conference, preprint server)."
        },
        "license": {
          "type": "string",
          "description": "License for the paper (e.g. 'CC BY 4.0')."
        },
        "keywords": {
          "type": "array",
          "description": "Keywords as submitted.",
          "items": { "type": "string" }
        },
        "abstract": {
          "type": "string",
          "description": "Full abstract text."
        },
        "superseded_by": {
          "type": "string",
          "description": "DOI of a later work that replaces this one (DataCite relationType IsObsoletedBy, schema 4.2+).",
          "pattern": "^10\\.\\d{4,}/.+$"
        }
      }
    },

    "claims": {
      "description": "Falsifiable claims made in the paper.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Short unique identifier for this claim (e.g. 'H1', 'P3', 'T2')."
          },
          "type": {
            "type": "string",
            "description": "Epistemic type of the claim.",
            "enum": ["hypothesis", "proposition", "theorem", "lemma", "corollary", "conjecture", "definition"]
          },
          "statement": {
            "type": "string",
            "description": "Full plain-language statement of the claim."
          },
          "formal": {
            "type": "string",
            "description": "Optional formal or mathematical statement."
          },
          "testable": {
            "type": "boolean",
            "description": "Whether the claim is empirically testable."
          },
          "tested_in_paper": {
            "type": "boolean",
            "description": "Whether the claim is tested within this paper."
          },
          "status": {
            "type": "string",
            "description": "The paper's verdict on the claim; the kind of support is in evidence_basis.",
            "enum": ["supported", "refuted", "inconclusive", "not_tested"]
          },
          "evidence_basis": {
            "type": "array",
            "description": "Kinds of warrant the paper gives for the claim, after the Evidence and Conclusion Ontology: deductive (ECO:0006185 author inference), computational (ECO:0007672), empirical (ECO:0000006 experimental evidence), literature (ECO:0000033 author statement supported by traceable reference).",
            "items": {
              "type": "string",
              "enum": ["deductive", "computational", "empirical", "literature"]
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "description": "IDs of other claims this claim logically depends on.",
            "items": { "type": "string" }
          }
        }
      }
    },

    "methodology": {
      "description": "Description of the research methodology.",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Primary methodology type. conceptual: verbal theory building (theory synthesis, theory adaptation, typology, model); theoretical: formal or deductive work.",
          "enum": ["empirical", "theoretical", "conceptual", "computational", "mixed", "meta_analysis", "review"]
        },
        "secondary_types": {
          "type": "array",
          "description": "Further methodology types used in a supporting role, from the same list (e.g. a theoretical paper with a computational demonstration).",
          "items": {
            "type": "string",
            "enum": ["empirical", "theoretical", "conceptual", "computational", "mixed", "meta_analysis", "review"]
          },
          "uniqueItems": true
        },
        "design": {
          "type": "string",
          "description": "Research design (e.g. 'between-subjects experiment', 'longitudinal survey', 'proof by construction')."
        },
        "sample": {
          "type": "object",
          "description": "Sample or dataset characteristics (for empirical work).",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "integer",
              "description": "Number of participants or observations."
            },
            "n": {
              "type": "integer",
              "description": "Deprecated synonym of size.",
              "deprecated": true
            },
            "population": {
              "type": "string",
              "description": "Population from which the sample is drawn."
            },
            "recruitment": {
              "type": "string",
              "description": "Recruitment method."
            },
            "exclusion": {
              "type": "array",
              "description": "Exclusion criteria.",
              "items": { "type": "string" }
            },
            "exclusion_criteria": {
              "type": "string",
              "description": "Deprecated: use exclusion.",
              "deprecated": true
            }
          }
        },
        "measures": {
          "type": "array",
          "description": "Key variables or constructs measured.",
          "items": {
            "type": "object",
            "required": ["variable"],
            "additionalProperties": false,
            "properties": {
              "variable": { "type": "string", "description": "Variable name." },
              "instrument": { "type": "string", "description": "Measurement instrument." },
              "reliability": { "type": "string", "description": "Reliability metric (e.g. 'Cronbach alpha = 0.87')." },
              "name": { "type": "string", "description": "Deprecated: use variable.", "deprecated": true },
              "construct": { "type": "string", "description": "Deprecated: describe the construct in variable or instrument.", "deprecated": true },
              "scale": { "type": "string", "description": "Deprecated: describe the scale in instrument.", "deprecated": true }
            }
          }
        },
        "analysis": {
          "type": "object",
          "description": "Statistical or analytical approach.",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string" },
            "software": { "type": "string" },
            "pre_registered": { "type": "boolean" },
            "pre_registration_url": { "type": "string" }
          }
        },
        "notes": {
          "type": "string",
          "description": "Additional context about the methodology."
        }
      }
    },

    "acceptance": {
      "description": "Explicit acceptance criteria — what would count as confirmation or refutation of each claim.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id"],
        "anyOf": [
          {"required": ["criterion"]},
          {"required": ["falsification"]}
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "description": "ID of the claim this criterion applies to."
          },
          "criterion": {
            "type": "string",
            "description": "Plain-language statement of what counts as passing."
          },
          "falsification": {
            "type": "string",
            "description": "What outcome would falsify the claim."
          },
          "threshold": {
            "type": "string",
            "description": "Quantitative threshold if applicable (e.g. 'p < 0.05', 'Cohen d > 0.3')."
          }
        }
      }
    },

    "data": {
      "description": "Information about underlying data.",
      "type": "object",
      "required": ["available"],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean",
          "description": "Whether the data are publicly available."
        },
        "url": {
          "type": "string",
          "description": "URL to access the data."
        },
        "format": {
          "type": "string",
          "description": "File format(s) (e.g. 'CSV', 'HDF5', 'SPSS .sav')."
        },
        "size": {
          "type": "string",
          "description": "Approximate data size (e.g. '12 MB', '45,000 rows')."
        },
        "license": {
          "type": "string",
          "description": "Data license (e.g. 'CC0', 'CC BY 4.0')."
        },
        "notes": {
          "type": "string",
          "description": "Additional context about the data."
        }
      }
    },

    "code": {
      "description": "Information about analysis code or software.",
      "type": "object",
      "required": ["available"],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean",
          "description": "Whether the code is publicly available."
        },
        "url": {
          "type": "string",
          "description": "URL to access the code (GitHub, Zenodo, etc.)."
        },
        "language": {
          "type": "string",
          "description": "Primary programming language(s)."
        },
        "dependencies": {
          "description": "Key libraries or packages, as a list, or how to install them, as a string (the v0.1.0 form).",
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "notes": {
          "type": "string",
          "description": "Additional context about the code."
        }
      }
    },

    "replication": {
      "description": "Guidance for independent replication.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feasible": {
          "type": "boolean",
          "description": "Whether replication is feasible with public resources."
        },
        "estimated_cost": {
          "type": "string",
          "description": "Approximate cost to replicate (e.g. 'under $500', 'institutional lab required')."
        },
        "estimated_time": {
          "type": "string",
          "description": "Estimated calendar time for replication (e.g. '3 months', '1 week')."
        },
        "requirements": {
          "type": "array",
          "description": "Special equipment, access, or expertise required.",
          "items": { "type": "string" }
        },
        "contact": {
          "type": "string",
          "description": "Contact email or URL for replication inquiries."
        }
      }
    },

    "dependencies": {
      "description": "Papers this work builds on, applies, or extends.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {"required": ["doi"]},
          {"required": ["reference"]}
        ],
        "properties": {
          "doi": {
            "type": "string",
            "description": "DOI of the dependency paper.",
            "pattern": "^10\\.\\d{4,}/.+$"
          },
          "reference": {
            "type": "string",
            "description": "Full citation string for works without DOIs (pre-DOI era, books)."
          },
          "claim": {
            "type": "string",
            "description": "Specific claim or result from the dependency that is used."
          },
          "relationship": {
            "type": "string",
            "description": "How this paper relates to the dependency; each value maps to a CiTO property (SPECIFICATION.md).",
            "enum": ["extends", "applies", "tests", "contradicts", "refines", "cites", "obtains_background_from", "cites_as_related"]
          },
          "critical": {
            "type": "boolean",
            "description": "Whether this dependency is load-bearing for the main argument."
          }
        }
      }
    },

    "contradictions": {
      "description": "Published work that contradicts or conflicts with findings here.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "our_position"],
        "anyOf": [
          {"required": ["doi"]},
          {"required": ["reference"]}
        ],
        "properties": {
          "doi": {
            "type": "string",
            "description": "DOI of the contradicting paper.",
            "pattern": "^10\\.\\d{4,}/.+$"
          },
          "reference": {
            "type": "string",
            "description": "Full citation string for works without DOIs."
          },
          "claim": {
            "type": "string",
            "description": "The specific claim in the cited work that conflicts."
          },
          "our_position": {
            "type": "string",
            "description": "How this paper addresses or explains the contradiction."
          }
        }
      }
    },

    "results": {
      "description": "Empirical or formal results, one entry per claim tested.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "status"],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "description": "ID of the claim this result pertains to."
          },
          "status": {
            "type": "string",
            "description": "Outcome of the test.",
            "enum": ["supported", "refuted", "partially_supported", "inconclusive", "not_tested"]
          },
          "effect_size": {
            "type": "string",
            "description": "Effect size with metric (e.g. 'd = 0.42', 'r = 0.31')."
          },
          "confidence_interval": {
            "type": "string",
            "description": "95% (or stated) confidence interval (e.g. '[0.18, 0.66]')."
          },
          "p_value": {
            "type": "string",
            "description": "p-value or Bayes factor (e.g. 'p = 0.003', 'BF = 12.4')."
          },
          "notes": {
            "type": "string",
            "description": "Additional context for interpreting the result."
          }
        }
      }
    },

    "limitations": {
      "description": "Acknowledged limitations of the study.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "description": "Plain-language description of the limitation."
          },
          "severity": {
            "type": "string",
            "description": "Severity relative to the main claims.",
            "enum": ["minor", "moderate", "major"]
          },
          "addressable": {
            "type": "boolean",
            "description": "Whether future work could address this limitation."
          }
        }
      }
    },

    "repositories": {
      "description": "Where the paper can be found across platforms.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "url"],
        "additionalProperties": false,
        "properties": {
          "platform": {"type": "string"},
          "url": {"type": "string"},
          "doi": {"type": "string", "pattern": "^10\\.\\d{4,}/.+$"},
          "version": {"type": "string"},
          "date": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },

    "submission_history": {
      "description": "Publication journey: submissions, decisions, revisions.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["venue", "date_submitted"],
        "additionalProperties": false,
        "properties": {
          "venue": {"type": "string"},
          "date_submitted": {"type": "string", "description": "Submission date, ISO 8601 at the precision known: YYYY-MM-DD, YYYY-MM or YYYY (EDTF level 0)."},
          "manuscript_id": {"type": "string"},
          "date_decision": {"type": "string", "description": "Decision date, same format as date_submitted."},
          "decision": {
            "type": "string",
            "enum": ["under_review", "desk_reject", "reject", "revise_resubmit", "accepted", "published", "withdrawn"]
          },
          "notes": {"type": "string"},
          "version_submitted": {"type": "string"}
        }
      }
    }

  }
}
